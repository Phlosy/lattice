{
  "name": "lattice",
  "productName": "Lattice",
  "version": "1.1.1",
  "description": "A cross-platform desktop coding agent powered by the Pi runtime.",
  "author": "Lattice Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config poc/tauri-app/src-tauri/tauri.conf.json",
    "build:ui": "vite build --config tauri-vite.config.ts",
    "build:sidecar": "bash scripts/build-pi-sidecar.sh",
    "build": "npm run build:ui && npm run build:sidecar && tauri build --config poc/tauri-app/src-tauri/tauri.conf.json",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "release:check": "bash scripts/release-check.sh",
    "gen:icon": "node scripts/gen-icon.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "diff": "8.0.4",
    "lucide-react": "^1.31.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/diff": "7.0.2",
    "@types/node": "22.19.19",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.3",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "zustand": "5.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "electron@43.4.0": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true,
    "@google/genai@1.52.0": true,
    "electron-winstaller@5.4.0": true
  }
}
