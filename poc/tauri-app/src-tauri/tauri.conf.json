{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lattice",
  "version": "1.1.1",
  "identifier": "dev.lattice.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lattice",
        "width": 1280,
        "height": 840,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "pi-sidecar"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 720,
          "height": 440
        },
        "windowPosition": {
          "x": 200,
          "y": 160
        },
        "appPosition": {
          "x": 180,
          "y": 245
        },
        "applicationFolderPosition": {
          "x": 540,
          "y": 245
        }
      }
    }
  }
}
